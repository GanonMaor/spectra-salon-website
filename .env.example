# Database Connection
NEON_DATABASE_URL='postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require'

# Authentication
JWT_SECRET=your-jwt-secret-key-here
JWT_ISSUER=https://your-api.example.com
JWT_AUDIENCE=your-platform-admin
WEBHOOK_SECRET=your-webhook-secret-here


# Email Service
RESEND_API_KEY=re_your_resend_key_here
EMAIL_FROM=noreply@your-domain.com
EMAIL_REPLY_TO=support@your-domain.com

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Application Settings
APP_NAME=Spectra Salon
APP_BASE_URL=https://your-site.netlify.app
VITE_APP_NAME=Spectra Salon
VITE_APP_VERSION=2.2.0
NODE_VERSION=18

# Development Settings
NODE_ENV=development
PIPELINE_MOCK_MODE=false

# Salon CRM login (netlify/functions/salon-login.js provisioned password path).
# Same variables in local .env.local and in Netlify production, so one set of
# credentials works in both places.
SALON_LOGIN_PASSWORD=your-crm-login-password
# Restricts who may use the shared password above (phones/emails, comma separated).
SALON_LOGIN_IDENTIFIERS=0504322680,maor@salonos.ai

# Local CRM safety (LOCAL ONLY — never set in Netlify production)
# 1 = local functions may READ the configured database but every mutation is
# rejected: 403 at the HTTP layer, and write SQL is refused by the pg client.
CRM_DEV_READONLY=1
# Salon used only by the local dev fallback in netlify/functions/_salon-context.js
# (i.e. when SALON_SESSION_SECRET is absent). A valid signed session always wins.
DEV_DEFAULT_SALON_ID=clean-salon-504322680
